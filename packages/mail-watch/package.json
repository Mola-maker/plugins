{
  "name": "@magpie-community/hooks-mail-watch",
  "version": "0.1.0",
  "description": "Email alerts from the gateway: provider errors and exhausted quotas, with your own recipients, templates and watch list",
  "type": "module",
  "files": ["mail-watch.hooks.js", "smtp.js", "watch.js", "template.js", "README.md"],
  "keywords": ["magpie", "magpie-hooks", "mail", "smtp", "alerts", "quota", "errors"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/magpie-community/plugins.git", "directory": "packages/mail-watch" },
  "magpie": {
    "hooks": "./mail-watch.hooks.js",
    "options": {
      "smtp": { "host": "smtp.example.com", "port": 465, "secure": true, "user": "me@example.com", "pass": "the app password", "from": "magpie@example.com" },
      "to": ["me@example.com"],
      "watch": { "errors": true, "quotaExhausted": true, "quotaLow": false, "quotaLowPct": 90, "providers": [] },
      "cooldownMinutes": { "error": 10, "quota": 240 },
      "template": {
        "subject": "[magpie] {{kind}} · {{provider}}{{window}}",
        "body": "What: {{kind}}\nProvider: {{provider}}{{account}}\n{{modelLine}}{{windowLine}}When: {{time}}\n\n{{detail}}"
      }
    }
  }
}
